#!/usr/bin/env node
// The shim that npm puts on the path.
//
// It finds the real binary and runs it. Standard input, standard output and
// standard error are handed straight to the child, so a terminal stays a
// terminal. That matters: secretveil decides who is calling by asking whether
// standard input and standard output are a terminal, and a pipe here would
// make every human look like an agent.
//
// The child is in the same process group as this shim, so Ctrl-C reaches both.
// spawnSync holds the event loop, so this program cannot forward a signal
// itself, and it does not have to.
//
// This shim costs about 20 ms of Node start time on each call. For "secretveil
// run", which wraps every command a developer types, install the binary itself
// instead. The README says how.

"use strict";

const { spawnSync } = require("node:child_process");
const { constants } = require("node:os");
const { binaryPath } = require("../index.js");

let binary;
try {
  binary = binaryPath();
} catch (err) {
  process.stderr.write(`${err.message}\n`);
  process.exit(1);
}

const result = spawnSync(binary, process.argv.slice(2), { stdio: "inherit" });

if (result.error) {
  process.stderr.write(`secretveil could not start ${binary}: ${result.error.message}\n`);
  process.exit(1);
}

// A shell reports a child that a signal stopped as 128 plus the number of the
// signal. Do the same, so a script that reads the exit code sees what it
// expects.
if (result.signal) {
  const number = constants.signals[result.signal];
  process.exit(number ? 128 + number : 1);
}

process.exit(result.status === null ? 1 : result.status);
